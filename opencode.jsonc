{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode/deepseek-v4.1-flash-free",
  // Ordered rules that allow, deny, or ask before a tool is used.
  // The LAST matching rule wins, so broad allows go first and the
  // sensitive exceptions come after them.
  "permissions": [
    // Default: do the work without prompting.
    { "action": "*", "resource": "*", "effect": "allow" },
    { "action": "shell", "resource": "*", "effect": "allow" },

    // Loading this skill requires explicit approval.
    { "action": "skill", "resource": "create-test-program", "effect": "ask" },

    // Secrets and credentials: always ask first.
    { "action": "read", "resource": "*.env", "effect": "ask" },
    { "action": "read", "resource": "*.env.*", "effect": "ask" },
    { "action": "edit", "resource": "*.env", "effect": "ask" },
    { "action": "edit", "resource": "*.env.*", "effect": "ask" },
    { "action": "read", "resource": "*.env.example", "effect": "allow" },
    { "action": "read", "resource": "*.env.sample", "effect": "allow" },
    { "action": "edit", "resource": "*.env.example", "effect": "allow" },
    { "action": "read", "resource": "*.ssh/*", "effect": "ask" },
    { "action": "read", "resource": "*id_rsa*", "effect": "ask" },
    { "action": "read", "resource": "*id_ed25519*", "effect": "ask" },
    { "action": "read", "resource": "*.aws/*", "effect": "ask" },
    { "action": "read", "resource": "*.gnupg/*", "effect": "ask" },
    { "action": "read", "resource": "*.kube/config", "effect": "ask" },
    { "action": "read", "resource": "*.git-credentials", "effect": "ask" },
    { "action": "read", "resource": "*.netrc", "effect": "ask" },

    // Normal git flow: commit and push without prompting.
    { "action": "shell", "resource": "git add *", "effect": "allow" },
    { "action": "shell", "resource": "git commit *", "effect": "allow" },
    { "action": "shell", "resource": "git status*", "effect": "allow" },
    { "action": "shell", "resource": "git diff*", "effect": "allow" },
    { "action": "shell", "resource": "git log*", "effect": "allow" },
    { "action": "shell", "resource": "git show*", "effect": "allow" },
    { "action": "shell", "resource": "git fetch*", "effect": "allow" },
    { "action": "shell", "resource": "git pull*", "effect": "allow" },
    { "action": "shell", "resource": "git push*", "effect": "allow" },
    { "action": "shell", "resource": "git branch*", "effect": "allow" },
    { "action": "shell", "resource": "git switch *", "effect": "allow" },
    { "action": "shell", "resource": "git checkout *", "effect": "allow" },
    { "action": "shell", "resource": "git stash*", "effect": "allow" },
    { "action": "shell", "resource": "git tag*", "effect": "allow" },
    { "action": "shell", "resource": "git remote -v", "effect": "allow" },
    { "action": "shell", "resource": "git rev-parse*", "effect": "allow" },
    { "action": "shell", "resource": "git ls-files*", "effect": "allow" },

    // Shell commands that reach outside the repo or rewrite history: ask.
    { "action": "shell", "resource": "cat *.env*", "effect": "ask" },
    { "action": "shell", "resource": "head *.env*", "effect": "ask" },
    { "action": "shell", "resource": "tail *.env*", "effect": "ask" },
    { "action": "shell", "resource": "less *.env*", "effect": "ask" },
    { "action": "shell", "resource": "more *.env*", "effect": "ask" },
    { "action": "shell", "resource": "grep * .env*", "effect": "ask" },
    { "action": "shell", "resource": "sed * .env*", "effect": "ask" },
    { "action": "shell", "resource": "cp *.env*", "effect": "ask" },
    { "action": "shell", "resource": "mv *.env*", "effect": "ask" },
    { "action": "shell", "resource": "source *.env*", "effect": "ask" },
    { "action": "shell", "resource": "cat *.pem", "effect": "ask" },
    { "action": "shell", "resource": "cat *.ssh/*", "effect": "ask" },
    { "action": "shell", "resource": "sudo *", "effect": "ask" },
    { "action": "shell", "resource": "git reset --hard *", "effect": "ask" },
    { "action": "shell", "resource": "git clean -f*", "effect": "ask" },
    { "action": "shell", "resource": "gh pr merge *", "effect": "ask" },
    { "action": "shell", "resource": "npm publish *", "effect": "ask" },
    { "action": "shell", "resource": "yarn publish *", "effect": "ask" },
    { "action": "shell", "resource": "pnpm publish *", "effect": "ask" },
    { "action": "shell", "resource": "bun publish *", "effect": "ask" },
    { "action": "shell", "resource": "cargo publish *", "effect": "ask" },
    { "action": "shell", "resource": "docker push *", "effect": "ask" },
    { "action": "shell", "resource": "twine upload *", "effect": "ask" },

    // Truly destructive commands: block outright.
    { "action": "shell", "resource": "git push *--force*", "effect": "deny" },
    { "action": "shell", "resource": "git push * -f*", "effect": "deny" },
    { "action": "shell", "resource": "rm -rf /*", "effect": "deny" },
    { "action": "shell", "resource": "rm -rf ~*", "effect": "deny" },
    { "action": "shell", "resource": "rm -rf $HOME*", "effect": "deny" },
    { "action": "shell", "resource": "rm -rf .", "effect": "deny" },
    { "action": "shell", "resource": "mkfs*", "effect": "deny" },
    { "action": "shell", "resource": "dd if=* of=/dev/*", "effect": "deny" },
    { "action": "shell", "resource": "shutdown *", "effect": "deny" },
    { "action": "shell", "resource": "reboot *", "effect": "deny" },

    // Subagents: block the explore agent outright.
    { "action": "subagent", "resource": "explore", "effect": "deny" },

    // .env files are never readable; overrides the earlier "ask" rule.
    { "action": "read", "resource": "*.env", "effect": "deny" }
  ],
  // Ignore playground log churn so it does not trigger watcher events.
  "watcher": {
    "ignore": ["logs/**"],
  },
  // Compact automatically, preserving recent tokens with a token buffer.
  "compaction": {
    "auto": true,
    "keep": {
      "tokens": 10000,
    },
    "buffer": 20000,
  },
  // Public, rate-limited Context7 endpoint: no API key or auth headers.
  // Notion uses OAuth: sign in via /mcps on first use.
  "mcp": {
    "servers": {
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp",
      },
      "notion": {
        "type": "remote",
        "url": "https://mcp.notion.com/mcp",
        "disabled": true,
      },
    },
  },
}
